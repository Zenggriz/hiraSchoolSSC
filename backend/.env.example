PORT=5000
# Production frontend origins comma separated; localhost sirf local development ke liye.
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000
# Local MongoDB ke liye default URI; Atlas istemal ho to neeche wala format apni values se bhar kar use karein.
MONGODB_URI=mongodb://127.0.0.1:27017/hira-school
# MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@cluster0.example.mongodb.net/hira-school?retryWrites=true&w=majority
ADMIN_TOKEN=replace-with-a-long-random-secret

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional website settings overrides; env values take priority over admin-saved values.
WEBSITE_LOCATION=
WEBSITE_CONTENT_JSON=
# Optional Cloudinary URL for the achievement image used in activities, leadership, and default gallery.
STUDENT_ACHIEVEMENT_IMAGE_URL=

GREEN_API_BASE_URL=https://api.green-api.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
